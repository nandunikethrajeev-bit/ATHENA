# ATHENA environment variables (example only).
# Copy to .env and fill in during later milestones. Never commit .env.

# M0 defines placeholders only. No real keys belong in this file or in source code.

# Contact email for polite access to OpenAlex / Crossref / PubMed (M1; not a secret).
# OPENALEX_EMAIL=

# Semantic Scholar Graph API key (M1; optional, free).
# SEMANTIC_SCHOLAR_API_KEY=

# NCBI / PubMed E-utilities API key (M1; optional, free).
# NCBI_API_KEY=

# LLM provider selection and credentials (M3+; documented when introduced).
# ATHENA_LLM_PROVIDER=
# ATHENA_LLM_MODEL=
# LLM_API_KEY=
