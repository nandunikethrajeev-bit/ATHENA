# ATHENA environment variables (example only).
# Copy to .env and fill in during later milestones. Never commit .env.

# M0 defines placeholders only. No real keys belong in this file or in source code.

# Contact email for polite access to OpenAlex / Crossref / PubMed (M1; not a secret).
# OPENALEX_EMAIL=

# Semantic Scholar Graph API key (M1; optional, free).
# SEMANTIC_SCHOLAR_API_KEY=

# NCBI / PubMed E-utilities API key (M1; optional, free).
# NCBI_API_KEY=

# LLM provider selection and credentials (M3: Scientific Evidence Synthesis)
# ATHENA_LLM_PROVIDER=mock      # Options: mock (offline), ollama (local), openai, openrouter
# ATHENA_LLM_MODEL=llama3.1:8b  # Model name (e.g. gpt-4o-mini, llama3.1:8b, mistral, qwen2.5:7b)
# LLM_API_KEY=                  # Required for OpenAI / OpenRouter; optional for local Ollama / mock
# LLM_BASE_URL=                 # Optional custom base URL (e.g. http://localhost:11434/v1 or https://openrouter.ai/api/v1)

# Embedding provider selection (M3: Persistent Storage & Hybrid Retrieval)
# ATHENA_EMBEDDING_PROVIDER=mock      # Options: mock (offline deterministic), ollama (local)
# ATHENA_EMBEDDING_MODEL=nomic-embed-text # Model name for embeddings (e.g. nomic-embed-text, qwen2.5:7b)

